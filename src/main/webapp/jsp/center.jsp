<%@page import="com.entity.User"%> <%@ page language="java" contentType="text/html; charset=UTF-8"     pageEncoding="UTF-8"%> <% 	User user = (User)request.getSession().getAttribute("user"); 	if(user == null){ 		response.sendRedirect("./login.jsp"); 	} %> <!DOCTYPE html> <html lang="en"> <head>     <meta charset="UTF-8">     <meta name="viewport" content="width=device-width, initial-scale=1.0">     <meta http-equiv="X-UA-Compatible" content="ie=edge">     <link href="../static/bootstrap/css/bootstrap.min.css" rel="stylesheet">     <link href="../static/bootstrap/css/bootstrap.css" rel="stylesheet">     <script src="../static/bootstrap/js/jquery-3.3.1.min.js"></script>     <script src="../static/bootstrap/js/bootstrap.min.js"></script>     <link rel="icon" type="image/x-icon" href="../static/images/logo.ico"/>     <link rel="stylesheet" type="text/css" href="../static/css/header.css">     <link rel="stylesheet" type="text/css" href="../static/css/center.css">     <link rel="stylesheet" type="text/css" href="../static/css/footer.css">     <script src="../static/js/header.js" charset="utf-8"></script>     <script src="../static/js/Api.js"></script>     <script src="../static/layui/layui.js" charset="utf-8"></script>     <link rel="stylesheet" href="../static/layui/css/layui.css" media="all">     <title>楣扮溂鐢靛奖-涓汉涓績</title> </head> <body>     <!-- ------------------------------------------------------------------- -->     <!-- 瀵艰埅鏍?-->     <jsp:include page="header.jsp"/>      <!-- 鍗犱綅绗?-->     <div style="margin-top: 110px;"></div>      <!-- 涓讳綋 -->     <div class="container">         <div class="contents">             <div class="nav-next">                 <div class="nav-title">                     <h3>涓汉涓績</h3>                 </div>                 <a class="cardId">鎴戠殑璁㈠崟</a> 				<a class="cardId">鍩烘湰淇℃伅</a> 				<a class="cardId">淇敼瀵嗙爜</a>             </div>             <div class="nav-body">                 <!-- 鎴戠殑璁㈠崟 -->                 <div class="one card" style="display: block;">                     <div>                         <div class="title">鎴戠殑璁㈠崟</div>                         <hr/>                     </div>                 </div>                 <!-- 鍩烘湰淇℃伅 璐﹀彿銆侀偖绠便€佽鑹层€佸ご鍍?-->                 <div class="two card" style="display: none;">                     <div>                         <div class="title">鍩烘湰淇℃伅</div>                         <hr/>                     </div>                     <div class="avatar-container layui-upload">                         <div class="layui-upload-list">                             <img class="layui-upload-img" id="demo1">                             <p id="demoText"></p>                         </div>                         <a href="javascript:;" class="file">閫夋嫨鏂囦欢                             <input type="file" name="file" id="file">                         </a>                         <div class="tips">鏀寔JPG,JPEG,PNG鏍煎紡锛屼笖鏂囦欢闇€灏忎簬1000KB</div>                     </div>                      <div class="avatar-body">                     </div>                 </div>                 <!-- 淇敼瀵嗙爜 -->                 <div class="three card" style="display: none;">                     <div>                         <div class="title">淇敼瀵嗙爜</div>                         <hr/>                     </div>                     <div class="avatar-body">                     </div>                 </div>             </div>         </div>     </div>       <!-- 鑴?-->     <jsp:include page="footer.jsp"/>               <!-- ------------------------------------------------------------------- -->     <script>         var clientHeight = document.documentElement.clientHeight;         var user = localStorage.getItem("userJson");         user = eval('(' + user + ')');         var file;          window.onload = function(){             initHeader();             initCard(); //鍒濆鍖栭€夐」鍗?            initOrder(); //鎴戠殑璁㈠崟             initInformation(); //鍩烘湰淇℃伅             initPassword(); //瀵嗙爜         }          //閫夐」鍗?       function initCard(){             var aArr = $(".nav-next").find(".cardId");             var divArr = $(".nav-body").find(".card");             if(localStorage.getItem("usercardId")==null){                 localStorage.setItem("usercardId",0);             }             for(var i=0; i<aArr.length; i++){                 aArr[i].index = i;                 aArr[i].onclick = function(){                     localStorage.setItem("usercardId",this.index);                     for(var j=0;j<divArr.length;j++){                         divArr[j].style.display = "none";                         aArr[j].style.cssText = "background-color: #f4f3f4; color: #333;";                     }                     divArr[this.index].style.display = "block";                     aArr[this.index].style.cssText = "background-color: #ed3931; color: #fff;";                 }             }             for(var p=0;p<aArr.length;p++){                 divArr[p].style.display = "none";                 aArr[p].style.cssText = "background-color: #f4f3f4; color: #333;";                 if(localStorage.getItem("usercardId")==p){                     divArr[p].style.display = "block";                     aArr[p].style.cssText = "background-color: #ed3931; color: #fff;";                 }             }         }            //鍒濆鍖栤€滄垜鐨勮鍗曗€?        function initOrder(){             var order = $(".one");             var html;             $.ajax({                 type:'post',                 url: url + "/order/findOrderByUserName",                 dataType:'json',                 data: {                     user_name: user.user_name                 },                 success:function (obj) {                     // console.log(obj);                     for(var i=0;i<obj.data.length;i++){                       //  var order_time = obj.data[i].order_schedule.schedule_startTime.slice(0,10);                         var StateText;                         switch(obj.data[i].order_state){                             case 0:                                 StateText = "閫€绁ㄤ腑";                             break;                             case 1:                                 StateText = "宸插畬鎴?;                             break;                             case 2:                                 StateText = "宸查€€绁?;                             break;                         }                         html =                          "<div class=\"order-box\">" +                             "<div class=\"order-head\">" +                                     "<span class=\"order-date\">" + obj.data[i].order_time + "</span>" +                                     "<span class=\"order-id\">璁㈠崟鍙凤細" + obj.data[i].order_id + "</span>" +                                     "<span class=\"order-delete\">*</span>" +                                     "</div>" +                             "<div class=\"order-body\">" +                                 "<div class=\"poster\"><img src=\"" + obj.data[i].order_schedule.schedule_movie.movie_picture + "\"></div>" +                                 "<div class=\"order-content\">" +                                     "<div class=\"movie-name\">" + obj.data[i].order_schedule.schedule_movie.movie_cn_name + "</div>" +                                     " <div class=\"cinema-name\">" + obj.data[i].order_schedule.schedule_hall.hall_cinema.cinema_name + "</div>" +                                     "<div class=\"hall-ticket\">"  + obj.data[i].order_schedule.schedule_hall.hall_name + " " + obj.data[i].order_position + "</div>" +                                     "<div class=\"show-time\">" + obj.data[i].order_schedule.schedule_startTime + "</div>" +                                 "</div>" +                                 "<div class=\"order-price\">锟? + obj.data[i].order_schedule.schedule_price + "</div>" +                                 "<div class=\"order-status\">" + StateText + "</div>" +                                 "<div class=\"actions\"><a onclick=\"backticket('" + obj.data[i].order_id + "','" + obj.data[i].order_schedule.schedule_startTime  + "','" + StateText + "')\" style=\"cursor: pointer;\">鐢宠閫€绁?/a></div>" +                             "</div>" +                         "</div>";                         order.append(html);                     }                 }             });         }         //閫€绁ㄧ敵璇?        function backticket(order_id,order_time,order_state){             var ShowTime = $(".one").find(".show-time");             var Year,Month,Day,Hour,Mintue,flag=0;             var myDate = new Date();             var OldTime, NowTime, OldDate, NowDate;             if(order_state=="閫€绁ㄤ腑"){                 layui.use(['layer'], function(){                 var layer = layui.layer;                     layer.alert('璇ヨ鍗曟澶勪簬閫€绁ㄧ姸鎬侊紒',{icon: 0,offset: clientHeight/5});                 });             }             else if(order_state=="宸查€€绁?){                 layui.use(['layer'], function(){                 var layer = layui.layer;                     layer.alert('璇ヨ鍗曞凡瀹屾垚閫€绁紒',{icon: 0,offset: clientHeight/5});                 });             }             else{                 if(myDate.getHours()==23){                     flag=1;                 }                 OldTime = order_time;                 NowTime = myDate.toLocaleDateString() + " " + parseInt(myDate.getHours()+1).toString()  + ":" + myDate.getMinutes();                 OldDate = new Date(OldTime.replace(/-/g,"\/"));                 NowDate = new Date(NowTime.replace(/-/g,"\/"));                 if(flag == 1){                     flag = 0;                     layui.use(['layer'], function(){                     var layer = layui.layer;                         layer.alert('23锛?0 - 00锛?0涓嶇粰浜堥€€绁ㄦ搷浣滐紒',{icon: 0,offset: clientHeight/5});                     });                 }                 else if(OldDate<NowDate){                     // window.alert("鏃ф椂闂达細" + OldDate + "\n鏂版椂闂达細" + NowDate + "\n閫€绁ㄦ椂闂翠负寮€鍦哄墠1灏忔椂澶栵紝閫€绁ㄧ敵璇峰け璐ワ紒");                     layui.use(['layer'], function(){                     var layer = layui.layer;                         layer.alert('閫€绁ㄦ椂闂翠负寮€鍦哄墠1灏忔椂澶栵紝閫€绁ㄧ敵璇峰け璐ワ紒',{icon: 0,offset: clientHeight/5});                     });                 }                 else{                     // window.alert("鏃ф椂闂达細" + OldDate + "\n鏂版椂闂达細" + NowDate + "\n閫€绁ㄥ凡鐢宠");                     layui.use(['layer'], function(){                     var layer = layui.layer;                         layer.alert('鏄惁纭瑕佺敵璇烽€€绁紒',{icon: 0,offset: clientHeight/5},                             function (){                                 $.ajax({                                     type:'post',                                     url: url + "/order/applyForRefund",                                     dataType:'json',                                     data: {                                         order_id: order_id                                     },                                     success:function (obj) {                                         if(obj.code == 0){                                             window.alert("閫€绁ㄥ凡鐢宠");                                         }                                         else{                                             window.alert("閫€绁ㄧ敵璇峰け璐ワ紒");                                         }                                     }                                 });                                 layer.closeAll();                                 location.reload();                             }                         );                     });                 }             }               }              //鍒濆鍖栧熀鏈俊鎭?        function initInformation(){             var avatarBody = $(".two").find(".avatar-body");             var roletext;             if(user.user_role==1){                 roletext = "绠＄悊鍛?;             }             else{                 roletext = "浼氬憳";             }              avatarBody.append(                 "<div class=\"userexinfo-form-section\">" +                     "<p>璐﹀彿锛?/p>" +                     "<span>" +                         "<input type=\"text\" name=\"userName\" id=\"userName\" value=\"" + user.user_name + "\" disabled=\"false\">" +                     "</span>" +                 "</div>" +                 "<div class=\"userexinfo-form-section\">" +                     "<p>韬唤锛?/p>" +                     "<span>" +                         "<input type=\"text\" name=\"role\" id=\"role\" value=\"" + roletext + "\" disabled=\"false\">" +                     "</span>" +                 "</div>" +                 "<div class=\"userexinfo-form-section\">" +                     "<p>閭锛?/p>" +                     "<span>" +                         "<input type=\"text\" name=\"email\" id=\"email\" value=\"" + user.user_email + "\">" +                     "</span>" +                 "</div>" +                 "<div class=\"userexinfo-btn-section\">" +                     "<input type=\"button\" onclick=\"saveBtn()\" class=\"form-save-btn\" value=\"淇濆瓨\">" +                 "</div>"             );             var HeadImg = "";             if(user.user_headImg == null || typeof user.user_headImg == "undefined"){                 HeadImg = "../upload/head/demo.jpg";             }else{                 HeadImg = user.user_headImg;             }             $('#demo1').attr('src', HeadImg);                          layui.use(['layer', 'table'], function(){                 var layer = layui.layer;                 var table = layui.table                  //鍥剧墖涓婁紶                 layui.use('upload', function(){                     var $ = layui.jquery                     ,upload = layui.upload;                              //鏅€氬浘鐗囦笂浼?                    var uploadInst = upload.render({                         elem: '#file'                         ,auto: false                         , choose: function (obj) {                             //棰勮鏈湴鏂囦欢                             obj.preview(function (index, file, result) {                                 $('#demo1').attr('src', result); //鍥剧墖閾炬帴锛坆ase64锛?                            })                             file = $('#file')[0].files[0];                         }                     });                 });             });         }         //淇濆瓨淇℃伅淇敼         function saveBtn(){             var formData = new FormData();             var user_name = $('#userName').val(),                 user_role = $('#role').val(),                 user_email = $('#email').val();             console.log(file);             console.log(user_name+ "," + user_role + "," + user_email);             if(user_role == "浼氬憳"){                 user_role = 0;             }else{                 user_role = 1;             }             if(user_email == ""){                 layui.use(['layer'], function(){                 var layer = layui.layer;                     layer.alert('閭淇℃伅涓嶈兘涓虹┖锛屼慨鏀瑰け璐ワ紒',{icon: 0,offset: clientHeight/5},                         function (){                             layer.close(layer.index);                         }                     );                 });             }             else{                 formData.append("user_id",user.user_id);                 formData.append("user_name",user_name);                 formData.append("user_role",user_role);                 formData.append("user_email",user_email);                 formData.append("file",file);                 $.ajax({                     type:'post',                     url: url + "/user/uploadHeadImg",                    // dataType:'json',                     data: formData,                     processData: false,                     contentType: false,                     success:function (result) {                         var obj = eval('(' + result + ')');                         if(obj.code == 0){                             layer.alert('淇敼鎴愬姛锛?,{icon: 0,offset: clientHeight/5},                                 function (){                                     localStorage.removeItem("userJson");                                     layer.closeAll();                                     localStorage.setItem("userJson",JSON.stringify(obj.data));                                     window.location.reload();                                 }                             );                         }else{                             layer.alert('淇敼澶辫触锛?,{icon: 0,offset: clientHeight/5},                                 function (){                                     layer.closeAll();                                 }                             );                         }                     }                 });             }         }              //鍒濆鍖栧瘑鐮?        function initPassword(){             var avatarBody = $(".three").find(".avatar-body");              avatarBody.append(                 "<div class=\"userexinfo-form-section\">" +                     "<p>鏃у瘑鐮侊細</p>" +                     "<span>" +                         "<input type=\"password\" name=\"oldPassword\" id=\"oldPassword\" value=\"\">" +                     "</span>" +                 "</div>" +                 "<div class=\"userexinfo-form-section\">" +                     "<p>鏂板瘑鐮侊細</p>" +                     "<span>" +                         "<input type=\"password\" name=\"newPassword\" id=\"newPassword\" value=\"\">" +                     "</span>" +                 "</div>" +                 "<div class=\"userexinfo-form-section\">" +                     "<p>纭瀵嗙爜锛?/p>" +                     "<span>" +                         "<input type=\"password\" name=\"repeatPassword\" id=\"repeatPassword\" value=\"\">" +                     "</span>" +                 "</div>" +                 "<div class=\"userexinfo-btn-section\">" +                     "<input type=\"submit\" onclick=\"savePasswordBtn()\" class=\"password-save-btn\" value=\"淇濆瓨\">" +                 "</div>"             );         }         //淇濆瓨瀵嗙爜淇敼         function savePasswordBtn(){             var user_old_password = $('#oldPassword').val(),                 user_new_password = $('#newPassword').val(),                 user_repeat_password = $('#repeatPassword').val();             var user_id = user.user_id;             console.log(user_old_password+ "," + user_new_password + "," + user_repeat_password);             if(user_old_password == "" || user_new_password == "" || user_repeat_password == ""){                 layui.use(['layer'], function(){                 var layer = layui.layer;                     layer.alert('瀵嗙爜淇敼淇℃伅涓嶈兘涓虹┖锛屼慨鏀瑰け璐ワ紒',{icon: 0,offset: clientHeight/5},                         function (){                             layer.close(layer.index);                         }                     );                 });             }             else if(user_old_password != user.user_pwd){                 layui.use(['layer'], function(){                 var layer = layui.layer;                     layer.alert('鏃у瘑鐮佽緭鍏ラ敊璇紒',{icon: 0,offset: clientHeight/5},                         function (){                             layer.close(layer.index);                         }                     );                 });             }             else if(user_new_password != user_repeat_password){                 layui.use(['layer'], function(){                 var layer = layui.layer;                     layer.alert('鏂板瘑鐮佸拰纭瀵嗙爜涓嶅尮閰嶏紒',{icon: 0,offset: clientHeight/5},                         function (){                             layer.close(layer.index);                         }                     );                 });             }             else{                 $.ajax({                     type:'post',                     url: url + "/user/modifyUserPwd",                     dataType:'json',                     data: {                         oldPwd: user_old_password,                         newPwd: user_new_password,                         user_id: user_id,                     },                     success:function (obj) {                         if(obj == "success"){                             layer.alert('淇敼鎴愬姛锛岃閲嶆柊鐧婚檰锛?,{icon: 0,offset: clientHeight/5},                                 function (){                                     layer.closeAll();                                     localStorage.removeItem("userJson");                                     window.location.reload();                                 }                             );                         }else{                             layer.alert('淇敼澶辫触锛?,{icon: 0,offset: clientHeight/5},                                 function (){                                     layer.closeAll();                                 }                             );                         }                     }                 });             }         }       </script>     <!-- ------------------------------------------------------------------- --> </body> </html>