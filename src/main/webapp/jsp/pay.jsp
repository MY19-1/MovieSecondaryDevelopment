<%@ page language="java" contentType="text/html; charset=UTF-8"     pageEncoding="UTF-8"%> <!DOCTYPE html> <html lang="en"> <head>     <meta charset="UTF-8">     <meta name="viewport" content="width=device-width, initial-scale=1.0">     <meta http-equiv="X-UA-Compatible" content="ie=edge">     <link href="../static/bootstrap/css/bootstrap.min.css" rel="stylesheet">     <link href="../static/bootstrap/css/bootstrap.css" rel="stylesheet">     <script src="../static/bootstrap/js/jquery-3.3.1.min.js"></script>     <script src="../static/bootstrap/js/bootstrap.min.js"></script>     <link rel="icon" type="image/x-icon" href="../static/images/logo.ico"/>     <link rel="stylesheet" type="text/css" href="../static/css/header.css">     <link rel="stylesheet" type="text/css" href="../static/css/pay.css">     <link rel="stylesheet" type="text/css" href="../static/css/footer.css">     <script src="../static/js/header.js" charset="utf-8"></script>     <script src="../static/js/Api.js"></script>     <script src="../static/layui/layui.js" charset="utf-8"></script>     <link rel="stylesheet" href="../static/layui/css/layui.css" media="all">     <title>楣扮溂鐢靛奖-鏀粯</title> </head> <body>     <!-- ------------------------------------------------------------------- -->     <!-- 瀵艰埅鏍?-->     <jsp:include page="header.jsp"/>      <!-- 鍗犱綅绗?-->     <div style="margin-top: 90px;"></div>      <!-- 涓讳綋 -->     <div class="container">         <div class="order-progress-bar">             <div class="step first done">                 <span class="step-num">1</span>                 <div class="bar"></div>                 <span class="step-next">閫夋嫨褰辩墖鍦烘</span>             </div>             <div class="step done">                 <span class="step-num">2</span>                 <div class="bar"></div>                 <span class="step-next">閫夋嫨搴т綅</span>             </div>             <div class="step done">                 <span class="step-num">3</span>                 <div class="bar"></div>                 <span class="step-next">浠樻</span>             </div>             <div class="step last">                 <span class="step-num">4</span>                 <div class="bar"></div>                 <span class="step-next">褰遍櫌鍙栫エ瑙傚奖</span>             </div>         </div>          <div class="count-down-wrapper">             <div class="count-down">                 <p class="time-left">                     璇峰湪<span class="minute"></span>鍒嗛挓<span class="second"></span>绉掑唴瀹屾垚鏀粯                 </p>                 <p class="tip">瓒呮椂璁㈠崟浼氳嚜鍔ㄥ彇娑堬紝濡傞亣鏀粯闂锛岃鑱旂郴绠＄悊鍛?/p>             </div>         </div>          <p class="warning">             璇蜂粩缁嗘牳瀵瑰満娆′俊鎭紝鍑虹エ鍚庡皢<span class="attention">鏃犳硶閫€绁ㄥ拰鏀圭</span>         </p>          <table class="order-table">             <thead>                 <tr>                     <th>褰辩墖</th>                     <th>鏃堕棿</th>                     <th>褰遍櫌</th>                     <th>搴т綅</th>                 </tr>             </thead>             <tbody>                <!-- 淇℃伅琛?-->             </tbody>         </table>          <div class="right">             <div class="price-wrapper">                 <span>瀹為檯鏀粯锛?/span>                 <span class="price"></span>             </div>             <div>                 <div class="pay-btn">纭鏀粯</div>             </div>         </div>     </div>      <!-- 鑴?-->     <jsp:include page="footer.jsp"/>      <!-- ------------------------------------------------------------------- -->     <script>         var clientHeight = document.documentElement.clientHeight;         var json = localStorage.getItem("order");         json = eval('(' + json + ')');         console.log(json);         var schedule_id = json.schedule_id;         var payBtn = $(".pay-btn");         window.onload = function(){             initHeader();             initPay(); //鏀粯             timeDown(); //璁℃椂鍣?        }          //鍒濆鍖栨敮浠橀〉闈?        function initPay(){             var orderTable = $(".order-table").find("tbody");             var TempLength = json.TicketSeat.split(",");             console.log(TempLength);             var price = json.price;             $.ajax({                 type:'post',                 url: url + "/schedule/findScheduleById",                 dataType:'json',                 data: {                     schedule_id: schedule_id                 },                 success:function (obj) {                     orderTable.append(                         "<tr>" +                             "<td class=\"movie-name\">" + obj.data.schedule_movie.movie_cn_name + "</td>" +                             "<td class=\"showtime\">" + obj.data.schedule_startTime + "</td>" +                             "<td class=\"cinema-name\">" + obj.data.schedule_hall.hall_cinema.cinema_name + "</td>" +                             "<td>" +                                 "<span class=\"hall\">" + obj.data.schedule_hall.hall_name + "</span>" +                                 "<div class=\"seats\">" +                                     "<div class=\"choiceseat\" style=\"display: block;\">" +                                     "</div>" +                                 "</div>" +                             "</td>" +                         "<tr>"                     );                     var choiceSeat = $(".choiceseat");                     for(var i=0;i<TempLength.length;i++){                         choiceSeat.append("<span class=\"border\" style=\"font-size: 15px;\">" + TempLength[i] + "</span>");                     }                 }             });              var choiceSeat = $(".choiceseat");             for(var i=0;i<TempLength.length;i++){                 choiceSeat.append("<span class=\"border\" style=\"font-size: 15px;\">" + TempLength[i] + "</span>");             }             $(".price").html(price);         }          //璁℃椂鍣?        function timeDown(){             var timeMinute = $(".minute");             var timeSecond = $(".second");             var minute;             var second;             timeMinute.text(localStorage.minute);             timeSecond.text(localStorage.second);             setInterval(function(){                 if(second==0 && minute==0){                     window.alert("鏀粯鏃堕棿宸茶繃锛岃鍗曞け鏁堬紒");                     localStorage.clear();                 }                 if((localStorage.second == "NaN") || (localStorage.second == 0 && localStorage.minute == 0))                 {                     localStorage.minute = 14;                     localStorage.second = 59;                 }                 second = localStorage.second;                 minute = localStorage.minute;                  if(second==0){                     minute--;                     second = 60;                 }                 second--;                 timeMinute.text(minute);                 timeSecond.text(second);                 localStorage.second = second;                 localStorage.minute = minute;             },1000);         }          //璐拱         payBtn[0].onclick = function(){             var position = json.TicketSeat.split(",");             var price = json.price;             $.ajax({                 type: "post",                 url: url + "/order/buyTickets",                 data: {                     schedule_id: schedule_id,                     position: position,                     price: price,                 },                 dataType: "json",                 success: function(obj){                 	localStorage.removeItem("order");                     if(obj.code == 0){                         layui.use(['layer'], function(){                             var layer = layui.layer;                             layer.alert('璐エ鎴愬姛锛?,{icon: 0,offset: clientHeight/5},                                  function (){                                     layer.closeAll();                                     document.location.href = "./payStatus.jsp";                                  }                             );                         });                     }else{                         layui.use(['layer'], function(){                             var layer = layui.layer;                             layer.alert(obj.msg,{icon: 0,offset: clientHeight/5},                                  function (){                                     layer.closeAll();                                  }                             );                         });                     }                 },                 error: function(){                     alert("network error");                 }             });         }          //鑾峰彇url鍙傛暟         function getUrlParams(name) { // 涓嶄紶name杩斿洖鎵€鏈夊€硷紝鍚﹀垯杩斿洖瀵瑰簲鍊?            var url = window.location.search;             if (url.indexOf('?') == 1) { return false; }             url = url.substr(1);             url = url.split('&');             var name = name || '';             var nameres;             // 鑾峰彇鍏ㄩ儴鍙傛暟鍙婂叾鍊?            for(var i=0;i<url.length;i++) {                 var info = url[i].split('=');                 var obj = {};                 obj[info[0]] = decodeURI(info[1]);                 url[i] = obj;             }             // 濡傛灉浼犲叆涓€涓弬鏁板悕绉帮紝灏卞尮閰嶅叾鍊?            if (name) {                 for(var i=0;i<url.length;i++) {                     for (const key in url[i]) {                         if (key == name) {                             nameres = url[i][key];                         }                     }                 }             } else {                 nameres = url;             }             // 杩斿洖缁撴灉             return nameres;         }      </script>     <!-- ------------------------------------------------------------------- --> </body> </html>